{
  "manifestVersion": 2,
  "id": "agent-workflow-canvas",
  "name": "Agent 工作流画布",
  "version": "2.3.4",
  "description": "多Agent协作工作流画布。粉哥hanako在岳主动要求分身或重大任务需规划时，先画布展示、等明确批准后派发；其他Agent依个人契约。保留DAG防冲突、批次等待与宿主能力门禁，画布生成不等批准。",
  "minAppVersion": "0.1013.0",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/ui.open-external",
    "app/resources.read",
    "app/resources.write",
    "app/session.start-turn",
    "app/sessions.manage"
  ],
  "contributes": {
    "cards": [
      {
        "id": "workflow",
        "title": "工作流调度画布",
        "description": "多Agent协作工作流调度画布",
        "route": "/workflow.html",
        "cardForm": "flush",
        "titlebar": "solid",
        "face": {
          "image": "face.svg"
        }
      }
    ]
  }
}
