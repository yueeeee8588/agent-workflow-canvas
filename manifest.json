{
  "manifestVersion": 2,
  "id": "agent-workflow-canvas",
  "name": "Agent 工作流画布",
  "version": "2.4.3",
  "description": "多Agent协作工作流画布。批准回传携带最终人员与可信方案读取指引，修复换人后沿用默认专员；刷新重发保持一致。保留DAG防冲突、自定义专员及无会话锁架构。",
  "minAppVersion": "0.1013.0",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/session.start-turn",
    "app/ui.open-external",
    "app/resources.read",
    "app/resources.write"
  ],
  "contributes": {
    "cards": [
      {
        "id": "workflow",
        "title": "工作流调度画布",
        "description": "多Agent协作工作流调度画布",
        "route": "/workflow.html",
        "cardForm": "flush",
        "titlebar": "solid",
        "face": {
          "image": "face.svg"
        }
      }
    ]
  }
}
