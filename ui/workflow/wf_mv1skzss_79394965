<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>挂载契约验证流 - 工作流调度看板 V2</title>
  <style>
:root {
  --bg-rice-paper: #F6F3EB;
  --bg-node: #FFFFFF;
  --bg-node-inner: #FAF7F0;
  --ink-primary: #2B2520;
  --ink-secondary: #6A6055;
  --ink-muted: #8E8376;
  --border-ink: #DFD7C8;
  --border-ink-subtle: #EBE5D8;
  --seal-vermilion: #B83B26;
  --seal-bg: rgba(184, 59, 38, 0.08);
  --bamboo-green: #2E5A44;
  --bamboo-bg: rgba(46, 90, 68, 0.08);
  --pine-cyan: #3A6073;
  --pine-light: #EBF1F5;
  --ink-shadow: 0 3px 12px rgba(43, 37, 32, 0.06);
  --node-width: 240px;
  --node-gap-x: 64px;
  --node-gap-y: 20px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg-rice-paper: #1B1917;
    --bg-node: #262320;
    --bg-node-inner: #1F1D1A;
    --ink-primary: #E7E2D8;
    --ink-secondary: #ABA092;
    --ink-muted: #7E7467;
    --border-ink: #423B33;
    --border-ink-subtle: #312C26;
    --seal-vermilion: #D9533F;
    --seal-bg: rgba(217, 83, 63, 0.15);
    --bamboo-green: #4D8B6E;
    --bamboo-bg: rgba(77, 139, 110, 0.15);
    --pine-cyan: #6E9FB5;
    --pine-light: rgba(110, 159, 181, 0.15);
    --ink-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg-rice-paper);
  color: var(--ink-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Source Han Serif SC", "Noto Serif CJK SC", Georgia, serif;
  line-height: 1.45;
  padding: 0 16px 16px 16px;
  /* 36px 标题安全区: 顶栏避让宿主卡片关闭/顶栏控件 */
  padding-top: 36px;
}

/* 顶部标题区 */
.header-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 14px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--border-ink);
}

.title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.main-title {
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
  letter-spacing: 0.5px;
}

.title-badge {
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 4px;
  font-weight: 600;
}

.badge-lane {
  background: var(--bamboo-bg);
  color: var(--bamboo-green);
  border: 1px solid var(--bamboo-green);
}

.badge-status-wait {
  background: var(--pine-light);
  color: var(--pine-cyan);
}

.badge-status-done {
  background: var(--bamboo-bg);
  color: var(--bamboo-green);
}

.lane-desc {
  font-size: 11.5px;
  color: var(--ink-secondary);
}

/* DAG 拓扑视口与画布 */
.dag-viewport-wrapper {
  position: relative;
  margin-bottom: 12px;
}

.dag-viewport {
  position: relative;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 10px 24px 16px 24px;
  background: var(--bg-rice-paper);
  cursor: grab;
  user-select: none;
  scroll-behavior: smooth;
}

.dag-viewport.is-dragging {
  cursor: grabbing;
  scroll-behavior: auto;
}

.dag-viewport::-webkit-scrollbar {
  height: 7px;
}
.dag-viewport::-webkit-scrollbar-track {
  background: #F2ECE0;
  border-radius: 4px;
}
.dag-viewport::-webkit-scrollbar-thumb {
  background: #B8AC9A;
  border-radius: 4px;
}
.dag-viewport::-webkit-scrollbar-thumb:hover {
  background: var(--pine-cyan);
}

.scroll-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--bg-node);
  border: 1.5px solid var(--border-ink);
  box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  color: var(--pine-cyan);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 20;
  transition: all 0.2s;
  font-size: 13px;
  font-weight: 700;
  opacity: 0.92;
}

.scroll-btn:hover {
  background: var(--pine-cyan);
  color: #FFFFFF;
  border-color: var(--pine-cyan);
  transform: translateY(-50%) scale(1.1);
}

.scroll-btn-left { left: 4px; }
.scroll-btn-right { right: 4px; }

.dag-canvas-container {
  position: relative;
  display: inline-block;
  min-width: 100%;
}

.svg-connections {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.dag-grid {
  display: flex;
  gap: var(--node-gap-x);
  position: relative;
  z-index: 2;
}

.dag-column {
  display: flex;
  flex-direction: column;
  gap: var(--node-gap-y);
  width: var(--node-width);
  flex-shrink: 0;
}

.stage-header {
  font-size: 11px;
  font-weight: 600;
  color: var(--ink-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  padding-bottom: 4px;
  border-bottom: 1px dashed var(--border-ink-subtle);
  display: flex;
  justify-content: space-between;
}

/* 节点卡片样式 */
.node-card {
  background: var(--bg-node);
  border: 1px solid var(--border-ink);
  border-radius: 8px;
  box-shadow: var(--ink-shadow);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: all 0.2s ease;
  position: relative;
}

.node-card:hover {
  border-color: var(--pine-cyan);
  box-shadow: 0 4px 18px rgba(43, 37, 32, 0.12);
}

.node-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.node-tag {
  font-size: 10px;
  font-weight: 700;
  color: var(--seal-vermilion);
  background: var(--seal-bg);
  padding: 2px 6px;
  border-radius: 3px;
  letter-spacing: 0.5px;
}

.node-id {
  font-size: 10px;
  color: var(--ink-muted);
  font-family: monospace;
}

.node-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-primary);
  line-height: 1.35;
}

.node-task {
  font-size: 11px;
  color: var(--ink-secondary);
  line-height: 1.4;
  background: var(--bg-node-inner);
  padding: 6px 8px;
  border-radius: 4px;
  border: 1px solid var(--border-ink-subtle);
}

.spec-block {
  font-size: 10.5px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.spec-item {
  display: flex;
  gap: 4px;
  line-height: 1.3;
}

.spec-label {
  color: var(--ink-muted);
  font-weight: 600;
  flex-shrink: 0;
}

.spec-val {
  color: var(--ink-secondary);
}

.conflict-warning {
  font-size: 10px;
  color: var(--seal-vermilion);
  background: var(--seal-bg);
  border: 1px solid rgba(184, 59, 38, 0.2);
  border-radius: 4px;
  padding: 4px 6px;
  line-height: 1.3;
}

.agent-selector-box {
  background: var(--bg-node-inner);
  border: 1px solid var(--border-ink);
  border-radius: 6px;
  padding: 6px 8px;
  margin-top: 4px;
}

.agent-select-title {
  font-size: 10px;
  color: var(--ink-muted);
  margin-bottom: 2px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.agent-select {
  width: 100%;
  border: none;
  background: transparent;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--pine-cyan);
  outline: none;
  cursor: pointer;
}

.agent-select optgroup {
  font-size: 11px;
  font-weight: 700;
  color: var(--ink-muted);
  background: var(--bg-node);
}

.agent-select option {
  font-size: 11.5px;
  font-weight: 500;
  color: var(--ink-primary);
  background: var(--bg-node);
  padding: 3px 6px;
}

/* 底部工具栏 */
.footer-bar {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid var(--border-ink);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.roster-summary {
  font-size: 11px;
  color: var(--ink-secondary);
  line-height: 1.4;
  flex: 1;
}

.source-meta {
  font-size: 10px;
  color: var(--ink-muted);
  margin-top: 2px;
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-secondary {
  background: var(--bg-node);
  color: var(--pine-cyan);
  border: 1px solid var(--pine-cyan);
  border-radius: 6px;
  padding: 7px 14px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: all 0.2s;
}

.btn-secondary:hover:not(:disabled) {
  background: var(--pine-light);
}

.btn-submit {
  background: var(--pine-cyan);
  color: #FFFFFF;
  border: none;
  border-radius: 6px;
  padding: 8px 18px;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 2px 8px rgba(58, 96, 115, 0.25);
  transition: all 0.2s;
}

.btn-submit:hover:not(:disabled) {
  opacity: 0.92;
  transform: translateY(-1px);
}

.btn-submit:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}

/* 内嵌自定义助手登记模态弹窗 */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(27, 25, 23, 0.48);
  backdrop-filter: blur(2px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.modal-backdrop.active {
  display: flex;
  opacity: 1;
}

.modal-card {
  background: var(--bg-node);
  border: 1px solid var(--border-ink);
  border-radius: 10px;
  width: 90%;
  max-width: 440px;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.22);
  padding: 20px;
  transform: translateY(12px) scale(0.98);
  transition: all 0.2s ease;
}

.modal-backdrop.active .modal-card {
  transform: translateY(0) scale(1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-ink-subtle);
}

.modal-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink-primary);
  display: flex;
  align-items: center;
  gap: 6px;
}

.modal-close {
  background: transparent;
  border: none;
  font-size: 16px;
  cursor: pointer;
  color: var(--ink-muted);
  padding: 4px 8px;
  border-radius: 4px;
  line-height: 1;
}

.modal-close:hover {
  background: var(--bg-node-inner);
  color: var(--ink-primary);
}

.modal-desc {
  font-size: 11.5px;
  color: var(--ink-secondary);
  margin-bottom: 14px;
  line-height: 1.45;
}

.modal-form-group {
  margin-bottom: 12px;
}

.modal-label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: var(--ink-secondary);
  margin-bottom: 4px;
}

.modal-input {
  width: 100%;
  padding: 8px 10px;
  background: var(--bg-node-inner);
  border: 1px solid var(--border-ink);
  border-radius: 6px;
  font-size: 12px;
  color: var(--ink-primary);
  outline: none;
  transition: border-color 0.2s;
}

.modal-input:focus {
  border-color: var(--pine-cyan);
}

.modal-error {
  font-size: 11px;
  color: var(--seal-vermilion);
  margin-top: 4px;
  display: none;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 18px;
}

.btn-modal-cancel {
  background: var(--bg-node-inner);
  border: 1px solid var(--border-ink);
  color: var(--ink-secondary);
  padding: 6px 14px;
  border-radius: 6px;
  font-size: 12px;
  cursor: pointer;
}

.btn-modal-cancel:hover {
  background: var(--border-ink-subtle);
}

.btn-modal-confirm {
  background: var(--pine-cyan);
  border: none;
  color: #FFFFFF;
  padding: 6px 16px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(58, 96, 115, 0.25);
}

.btn-modal-confirm:hover {
  opacity: 0.92;
}
</style>
</head>
<body>

  <!-- 36px 标题安全区在 body 顶部生效 -->
  <div class="header-bar">
    <div class="title-wrap">
      <div class="main-title">
        <span>🧭</span>
        <span>挂载契约验证流</span>
        <span class="title-badge badge-lane">Worker Lane</span>
        <span class="title-badge badge-status-wait" id="status-badge">待审阅并确认启动</span>
      </div>
      <div class="lane-desc">符合 Worker Lane 依据：[专项能力专员派发]，按实际收益独立完成，简短回报状态、产物、验证证据与问题；主控按有效精简契约复核。</div>
    </div>
  </div>

  

  <div class="dag-viewport-wrapper">
    <button type="button" class="scroll-btn scroll-btn-left" id="scroll-btn-left" title="向左滑动">‹</button>
    <button type="button" class="scroll-btn scroll-btn-right" id="scroll-btn-right" title="向右滑动">›</button>

    <div class="dag-viewport" id="dag-viewport">
      <div class="dag-canvas-container" id="dag-container">
        <svg class="svg-connections" id="svg-connections">
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--ink-secondary)" />
            </marker>
            <marker id="arrow-conflict" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--seal-vermilion)" />
            </marker>
          </defs>
        </svg>
        <div class="dag-grid" id="dag-grid">
          
    <div class="dag-column" data-layer-index="0">
      <div class="stage-header">
        <span>Stage 1</span>
        <span>1 个任务</span>
      </div>
      
  <div class="node-card" id="node-step1" data-node-id="step1">
    <div class="node-top">
      <span class="node-tag">Phase 1</span>
      <span class="node-id">#step1</span>
    </div>
    <div class="node-title">任务1</div>
    <div class="node-task">任务1</div>

    <div class="spec-block">
      <div class="spec-item">
        <span class="spec-label">前置依赖:</span>
        <span class="spec-val">无 (初始任务)</span>
      </div>
      <div class="spec-item">
        <span class="spec-label">权限边界:</span>
        <span class="spec-val">遵从所属 Agent 标准权限边界</span>
      </div>
      <div class="spec-item">
        <span class="spec-label">预期产物:</span>
        <span class="spec-val">产出完整结论与结构化结果</span>
      </div>
      <div class="spec-item">
        <span class="spec-label">验收条件:</span>
        <span class="spec-val">结果符合预期且经独立验证</span>
      </div>
      
    </div>

    <div class="agent-selector-box" >
      <div class="agent-select-title">
        <span >
          执行专员 (支持换人)
        </span>
      </div>
      <select class="agent-select" data-node-id="step1" data-is-invalid="false">
        <optgroup label="核心协同团队 (Core Team)"><option value="lead" >主控编排 (lead / orchestrator) [主控编排职责]</option><option value="architect" >系统架构 (architect) [架构推演职责]</option><option value="coder" selected>全栈开发 (coder) [代码编写职责]</option><option value="reviewer" >代码审查 (reviewer) [审查核验职责]</option></optgroup><optgroup label="工程落地与运维 (Engineering &amp; Ops)"><option value="devops" >运维专员 (devops) [运维部署职责]</option><option value="browser" >网页执行官 (browser) [网页检索职责]</option><option value="ui-designer" >前端工匠 (ui-designer) [界面设计职责]</option></optgroup><optgroup label="深度分析与推演 (Analysis &amp; Deduction)"><option value="analyst" >综合分析 (analyst) [综合分析职责]</option></optgroup><optgroup label="本地与自定义专员 (Local &amp; Custom)"><option value="domain-specialist" >领域专家 (domain-specialist) [专项分析职责]</option><option value="akang-2" >阿康 (akang-2) [本地专员职责]</option><option value="browser-agent" >网页执行官 (browser-agent) [本地专员职责]</option><option value="dafeiyu" >大肥鱼 (dafeiyu) [本地专员职责]</option><option value="green" >绿哥 (green) [本地专员职责]</option><option value="hajimi" >哈基米 (hajimi) [本地专员职责]</option><option value="hanako" >粉哥 (hanako) [本地专员职责]</option><option value="hanako-lite" >轻装粉哥 (hanako-lite) [本地专员职责]</option><option value="jiediange" >节点哥 (jiediange) [本地专员职责]</option><option value="jiediange-93fdb2" >节点哥 (jiediange-93fdb2) [本地专员职责]</option><option value="kouzi" >骚扣 (kouzi) [本地专员职责]</option><option value="lange" >蓝哥 (lange) [本地专员职责]</option><option value="laok" >老K (laok) [本地专员职责]</option><option value="mawang" >马王 (mawang) [本地专员职责]</option><option value="qianwen" >千问 (qianwen) [本地专员职责]</option><option value="xutao" >徐涛 (xutao) [本地专员职责]</option></optgroup><optgroup label="➕ 动态指派"><option value="__add_custom__">➕ 输入自定义助手 ID / 新助手...</option></optgroup>
      </select>
    </div>
  </div>
    </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bar">
    <div class="roster-summary">
      <div id="route-summary">正在计算流水线人员排布...</div>
      <div class="source-meta">专员名录快照来源：本地环境与通用角色</div>
    </div>
    <div class="footer-actions">
      <button type="button" class="btn-secondary" id="btn-add-agent" >
        <span>➕</span>
        <span>添加自定义助手</span>
      </button>
      <button type="button" class="btn-submit" id="btn-submit" >
        <span>🚀</span>
        <span id="btn-text">确认方案 · 启动全链路调度</span>
      </button>
    </div>
  </div>

  <!-- 内嵌自定义助手登记模态弹窗 (不依赖任何外部弹窗或 prompt) -->
  <div class="modal-backdrop" id="custom-modal-backdrop">
    <div class="modal-card" id="custom-modal">
      <div class="modal-header">
        <div class="modal-title">
          <span>➕</span>
          <span>登记新助手到当前看板</span>
        </div>
        <button type="button" class="modal-close" id="modal-btn-close">✕</button>
      </div>
      <div class="modal-desc">
        登记自定义助手或特化子代理 ID，添加后将同步开放给所有任务节点指派。
      </div>
      <div class="modal-form-group">
        <label class="modal-label" for="modal-agent-id">助手唯一标识 (Agent ID) <span style="color:var(--seal-vermilion)">*</span></label>
        <input type="text" class="modal-input" id="modal-agent-id" placeholder="例如: researcher-1, my-new-agent" autocomplete="off" />
        <div class="modal-error" id="modal-id-error">仅支持 1-64 位英文字母、数字、下划线与短横线</div>
      </div>
      <div class="modal-form-group">
        <label class="modal-label" for="modal-agent-name">显示名称 (可选)</label>
        <input type="text" class="modal-input" id="modal-agent-name" placeholder="例如: 深度检索专员 (默认同 ID)" autocomplete="off" />
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-modal-cancel" id="modal-btn-cancel">取消</button>
        <button type="button" class="btn-modal-confirm" id="modal-btn-confirm">确认添加并指派</button>
      </div>
    </div>
  </div>

  <!-- 纯 DOM 模态通知弹窗 (彻底杜绝原生 alert 与 prompt) -->
  <div class="modal-backdrop" id="alert-modal-backdrop">
    <div class="modal-card" id="alert-modal">
      <div class="modal-header">
        <div class="modal-title">
          <span id="alert-modal-icon">⚠️</span>
          <span id="alert-modal-title">系统提示</span>
        </div>
        <button type="button" class="modal-close" id="alert-btn-close">✕</button>
      </div>
      <div class="modal-desc" id="alert-modal-msg" style="font-size:12.5px;line-height:1.6;margin-bottom:18px;color:var(--ink-primary);word-break:break-word;">
      </div>
      <div class="modal-actions" style="justify-content:flex-end;">
        <button type="button" class="btn-modal-confirm" id="alert-btn-confirm">知道了</button>
      </div>
    </div>
  </div>

  <script>
  (function() {
    var PROTO = "hana.plugin.ui";
    function post(type, payload) {
      try { window.parent.postMessage({ protocol: PROTO, version: 1, kind: "event", type: type, payload: payload }, "*"); } catch(e) {}
    }
    post("hana.ready");

    function resize() {
      post("ui.resize", { height: (document.documentElement.scrollHeight || document.body.scrollHeight) + 24 });
    }
    window.addEventListener("load", resize);
    if (window.ResizeObserver) { try { new ResizeObserver(resize).observe(document.body); } catch(e) {} }

    var EDGES = [];
    var WORKFLOW_ID = "wf_mv1skzss_79394965";
    var ALREADY_DONE = false;
    var CUSTOM_AGENTS = [];

    var svg = document.getElementById("svg-connections");
    var container = document.getElementById("dag-container");
    var selects = Array.prototype.slice.call(document.querySelectorAll(".agent-select"));
    var summaryEl = document.getElementById("route-summary");
    var btn = document.getElementById("btn-submit");
    var btnAddAgent = document.getElementById("btn-add-agent");
    var btnText = document.getElementById("btn-text");
    var badge = document.getElementById("status-badge");

    // 动态绘制真实贝塞尔曲线 DAG 连线
    function drawDagEdges() {
      var containerRect = container.getBoundingClientRect();
      var defs = svg.querySelector("defs").outerHTML;
      var pathsHtml = defs;

      EDGES.forEach(function(edge) {
        var fromEl = document.getElementById("node-" + edge.from);
        var toEl = document.getElementById("node-" + edge.to);
        if (!fromEl || !toEl) return;

        var fromRect = fromEl.getBoundingClientRect();
        var toRect = toEl.getBoundingClientRect();

        // 起点位于源卡片右中，终点位于目标卡片左中
        var x1 = (fromRect.right - containerRect.left);
        var y1 = (fromRect.top + fromRect.height / 2 - containerRect.top);
        var x2 = (toRect.left - containerRect.left);
        var y2 = (toRect.top + toRect.height / 2 - containerRect.top);

        var dx = Math.max(30, (x2 - x1) / 2);
        var cx1 = x1 + dx;
        var cy1 = y1;
        var cx2 = x2 - dx;
        var cy2 = y2;

        var isConflict = edge.type === "conflict-serialized";
        var strokeColor = isConflict ? "var(--seal-vermilion)" : "var(--ink-secondary)";
        var strokeDash = isConflict ? "stroke-dasharray='4,4'" : "";
        var markerId = isConflict ? "url(#arrow-conflict)" : "url(#arrow)";

        pathsHtml += '<path d="M ' + x1 + ' ' + y1 + ' C ' + cx1 + ' ' + cy1 + ', ' + cx2 + ' ' + cy2 + ', ' + x2 + ' ' + y2 + '" '
          + 'fill="none" stroke="' + strokeColor + '" stroke-width="1.8" ' + strokeDash + ' marker-end="' + markerId + '" opacity="0.75" />';
      });

      svg.innerHTML = pathsHtml;
    }

    window.addEventListener("load", drawDagEdges);
    window.addEventListener("resize", drawDagEdges);
    setTimeout(drawDagEdges, 60);

    // 动态向所有下拉框注册新助手
    function registerCustomAgent(agentId, agentName) {
      if (!agentId || !/^[a-zA-Z0-9_-]{1,64}$/.test(agentId)) {
        return null;
      }
      var displayName = agentName || agentId;
      var exists = CUSTOM_AGENTS.some(function(a) { return a.id === agentId; });
      if (!exists) {
        CUSTOM_AGENTS.push({ id: agentId, name: displayName, desc: "自定义指派专员" });
        selects.forEach(function(s) {
          var opt = document.createElement("option");
          opt.value = agentId;
          opt.textContent = displayName + " (" + agentId + ") [自定义专员]";
          // 插入到最前面的选项中
          var customGroup = s.querySelector("optgroup[label*='动态指派']");
          if (customGroup) {
            customGroup.insertBefore(opt, customGroup.firstChild);
          } else {
            s.appendChild(opt);
          }
        });
      }
      return agentId;
    }

    // 更新人员路线摘要并执行就绪守卫
    function updateSummary() {
      var hasUnassigned = false;
      var plan = selects.map(function(s) {
        var nid = s.dataset.nodeId;
        var val = s.value;
        if (!val || val === "__add_custom__") {
          hasUnassigned = true;
          return nid + " ➔ ⚠️ 未指定有效专员";
        }
        var selOpt = s.options[s.selectedIndex];
        var agentName = selOpt ? selOpt.text.split(" ")[0] : s.value;
        return nid + " ➔ " + agentName;
      });

      if (hasUnassigned && !ALREADY_DONE) {
        summaryEl.innerHTML = "<span style='color:var(--seal-vermilion);font-weight:600;'>⚠️ 存在未指定或未授权专员，请在上方卡片中更换为有效专员后方可启动。</span>";
        btn.disabled = true;
        btnText.textContent = "请先指定所有有效专员";
      } else {
        summaryEl.textContent = "当前流水线配置：" + plan.join(" | ");
        if (!ALREADY_DONE) {
          btn.disabled = false;
          btnText.textContent = "确认方案 · 启动全链路调度";
        }
      }
    }

    // 内嵌模态框交互逻辑 (纯 DOM，杜绝 prompt 拦截失效)
    var modalBackdrop = document.getElementById("custom-modal-backdrop");
    var modalIdInput = document.getElementById("modal-agent-id");
    var modalNameInput = document.getElementById("modal-agent-name");
    var modalIdError = document.getElementById("modal-id-error");
    var modalBtnClose = document.getElementById("modal-btn-close");
    var modalBtnCancel = document.getElementById("modal-btn-cancel");
    var modalBtnConfirm = document.getElementById("modal-btn-confirm");
    var activeTriggerSelect = null;
    var previousSelectValue = null;

    function openCustomModal(triggerSelect) {
      activeTriggerSelect = triggerSelect || null;
      previousSelectValue = triggerSelect ? (triggerSelect.dataset.lastValidValue || triggerSelect.options[0].value) : null;
      modalIdInput.value = "";
      modalNameInput.value = "";
      modalIdError.style.display = "none";
      modalBackdrop.classList.add("active");
      setTimeout(function() { modalIdInput.focus(); }, 60);
    }

    function closeCustomModal() {
      modalBackdrop.classList.remove("active");
      if (activeTriggerSelect && activeTriggerSelect.value === "__add_custom__") {
        activeTriggerSelect.value = previousSelectValue || activeTriggerSelect.options[0].value;
        updateSummary();
      }
      activeTriggerSelect = null;
    }

    // 纯 DOM 模态通知处理逻辑 (杜绝 alert / prompt)
    var alertBackdrop = document.getElementById("alert-modal-backdrop");
    var alertTitle = document.getElementById("alert-modal-title");
    var alertMsg = document.getElementById("alert-modal-msg");
    var alertIcon = document.getElementById("alert-modal-icon");
    var alertBtnClose = document.getElementById("alert-btn-close");
    var alertBtnConfirm = document.getElementById("alert-btn-confirm");

    function showAlertModal(message, title, icon) {
      if (alertTitle) alertTitle.textContent = title || "系统提示";
      if (alertIcon) alertIcon.textContent = icon || "⚠️";
      if (alertMsg) alertMsg.textContent = message || "";
      if (alertBackdrop) alertBackdrop.classList.add("active");
    }

    function closeAlertModal() {
      if (alertBackdrop) alertBackdrop.classList.remove("active");
    }

    if (alertBtnClose) alertBtnClose.addEventListener("click", closeAlertModal);
    if (alertBtnConfirm) alertBtnConfirm.addEventListener("click", closeAlertModal);
    if (alertBackdrop) {
      alertBackdrop.addEventListener("click", function(e) {
        if (e.target === alertBackdrop) closeAlertModal();
      });
    }

    if (modalBtnClose) modalBtnClose.addEventListener("click", closeCustomModal);
    if (modalBtnCancel) modalBtnCancel.addEventListener("click", closeCustomModal);
    if (modalBackdrop) {
      modalBackdrop.addEventListener("click", function(e) {
        if (e.target === modalBackdrop) closeCustomModal();
      });
    }
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        if (modalBackdrop && modalBackdrop.classList.contains("active")) {
          closeCustomModal();
        }
        if (alertBackdrop && alertBackdrop.classList.contains("active")) {
          closeAlertModal();
        }
      }
    });

    function handleConfirmCustomAgent() {
      var rawId = modalIdInput.value.trim();
      var rawName = modalNameInput.value.trim();

      if (!rawId || !/^[a-zA-Z0-9_-]{1,64}$/.test(rawId)) {
        modalIdError.style.display = "block";
        modalIdInput.focus();
        return;
      }

      var registeredId = registerCustomAgent(rawId, rawName || rawId);
      if (registeredId) {
        if (activeTriggerSelect) {
          activeTriggerSelect.value = registeredId;
          activeTriggerSelect.dataset.lastValidValue = registeredId;
        }
        updateSummary();
      }
      modalBackdrop.classList.remove("active");
      activeTriggerSelect = null;
    }

    if (modalBtnConfirm) modalBtnConfirm.addEventListener("click", handleConfirmCustomAgent);
    if (modalIdInput) {
      modalIdInput.addEventListener("keydown", function(e) {
        if (e.key === "Enter") handleConfirmCustomAgent();
      });
      modalIdInput.addEventListener("input", function() {
        modalIdError.style.display = "none";
      });
    }
    if (modalNameInput) {
      modalNameInput.addEventListener("keydown", function(e) {
        if (e.key === "Enter") handleConfirmCustomAgent();
      });
    }

    selects.forEach(function(s) {
      s.dataset.lastValidValue = s.value;
      s.addEventListener("change", function() {
        if (s.value === "__add_custom__") {
          openCustomModal(s);
        } else {
          s.dataset.lastValidValue = s.value;
          updateSummary();
        }
      });
    });
    updateSummary();

    if (btnAddAgent) {
      btnAddAgent.addEventListener("click", function() {
        openCustomModal(null);
      });
    }

    // 画布左右滑动控制与抓手拖拽系统
    var viewportEl = document.getElementById("dag-viewport");
    var btnScrollL = document.getElementById("scroll-btn-left");
    var btnScrollR = document.getElementById("scroll-btn-right");

    if (viewportEl && btnScrollL && btnScrollR) {
      function updateViewportScrollButtons() {
        var atLeft = viewportEl.scrollLeft <= 5;
        var atRight = viewportEl.scrollLeft + viewportEl.clientWidth >= viewportEl.scrollWidth - 8;
        btnScrollL.style.opacity = atLeft ? "0.25" : "0.95";
        btnScrollL.style.pointerEvents = atLeft ? "none" : "auto";
        btnScrollR.style.opacity = atRight ? "0.25" : "0.95";
        btnScrollR.style.pointerEvents = atRight ? "none" : "auto";
      }

      btnScrollL.addEventListener("click", function(e) {
        e.stopPropagation();
        viewportEl.scrollBy({ left: -220, behavior: "smooth" });
      });
      btnScrollR.addEventListener("click", function(e) {
        e.stopPropagation();
        viewportEl.scrollBy({ left: 220, behavior: "smooth" });
      });

      viewportEl.addEventListener("scroll", updateViewportScrollButtons);
      window.addEventListener("resize", updateViewportScrollButtons);
      setTimeout(updateViewportScrollButtons, 80);

      // 滚轮直接转换为横向滚动
      viewportEl.addEventListener("wheel", function(e) {
        if (e.deltaY !== 0) {
          e.preventDefault();
          viewportEl.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      // 鼠标按住抓手拖拽 (Drag to Scroll)
      var isViewportDragging = false;
      var dragStartX = 0;
      var dragScrollLeft = 0;

      viewportEl.addEventListener("mousedown", function(e) {
        if (e.target.tagName === "SELECT" || e.target.tagName === "OPTION" || e.target.tagName === "BUTTON") return;
        isViewportDragging = true;
        viewportEl.classList.add("is-dragging");
        dragStartX = e.pageX - viewportEl.offsetLeft;
        dragScrollLeft = viewportEl.scrollLeft;
      });

      window.addEventListener("mouseup", function() {
        if (isViewportDragging) {
          isViewportDragging = false;
          viewportEl.classList.remove("is-dragging");
        }
      });

      viewportEl.addEventListener("mousemove", function(e) {
        if (!isViewportDragging) return;
        e.preventDefault();
        var curX = e.pageX - viewportEl.offsetLeft;
        var dist = (curX - dragStartX) * 1.4;
        viewportEl.scrollLeft = dragScrollLeft - dist;
      });
    }

    // 提交调度执行
    var isSubmitting = false;
    btn.addEventListener("click", function() {
      if (ALREADY_DONE || isSubmitting) return;

      isSubmitting = true;
      btn.disabled = true;
      btnText.textContent = "正在等待宿主 Bus 应答...";

      var assignments = {};
      selects.forEach(function(s) {
        assignments[s.dataset.nodeId] = s.value;
      });

      var surfaceSession = new URLSearchParams(window.location.search).get("pluginSurfaceSession") || new URLSearchParams(window.location.search).get("appSurfaceSession");
      var headers = { "Content-Type": "application/json" };
      if (surfaceSession) {
        headers["X-Hana-Plugin-Surface-Session"] = surfaceSession;
        headers["X-Hana-App-Surface-Session"] = surfaceSession;
      }

      // 智能识别当前运行宿主模式：v2 App 走 /api/apps/.../routes，旧版兼容走 /api/plugins/...
      var postUrl = (window.location.pathname.indexOf("/api/apps/") >= 0 || window.location.pathname.indexOf("/routes/") >= 0)
        ? "/api/apps/agent-workflow-canvas/routes/workflow/" + WORKFLOW_ID + "/execute"
        : "/api/plugins/agent-workflow-canvas/workflow/" + WORKFLOW_ID + "/execute";

      fetch(postUrl, {
        method: "POST",
        headers: headers,
        body: JSON.stringify({
          assignments: assignments,
          customAgents: CUSTOM_AGENTS
        })
      })
      .then(function(res) {
        return res.json().then(function(json) {
          return { status: res.status, ok: res.ok, data: json };
        }).catch(function() {
          return { status: res.status, ok: false, data: { message: "解析响应失败" } };
        });
      })
      .then(function(result) {
        isSubmitting = false;
        if (result.ok && result.data && result.data.ok) {
          ALREADY_DONE = true;
          btnText.textContent = "已成功交接宿主调度总线";
          badge.textContent = "已投递调度 Bus";
          badge.className = "title-badge badge-status-done";
        } else {
          var errMsg = (result.data && (result.data.message || result.data.error)) || "网络异常";
          var isDeliveryUnknown = result.data && result.data.error === "delivery_unknown";
          var locked = [409,423,504].indexOf(result.status) >= 0 || (result.status === 502 && isDeliveryUnknown) || isDeliveryUnknown || !result.data || !result.data.error;
          if (locked) ALREADY_DONE = true;
          btn.disabled = locked;
          btnText.textContent = locked ? "送达状态未决，请核实主会话" : "重新提交计划";
          showAlertModal("计划未确认提交: " + errMsg, "提交未完成", "⚠️");
        }
      })
      .catch(function(err) {
        isSubmitting = false;
        ALREADY_DONE = true;
        btn.disabled = true;
        btnText.textContent = "送达状态不明，请核实主会话";
        showAlertModal("网络请求未得到确认，请先核实主会话，勿重复提交: " + (err && err.message ? err.message : err), "投递状态未决", "🔒");
      });
    });
  })();
  </script>
</body>
</html>